# BrewPOS - Environment Configuration (PostgreSQL)
# Copy this file to .env and fill in your values.

# --- Flask / Session ---
BREWPOS_SECRET_KEY=change_this_to_a_random_secret

# --- PostgreSQL Connection ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brewpos
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# --- Application Constants ---
LOW_STOCK_THRESHOLD=10
EXPIRING_DAYS=7

# --- SMTP / OTP Email (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=BrewPOS
OTP_EXPIRY_MINUTES=10

# --- Resend API (OTP email delivery) ---
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=BrewPOS <noreply@yourdomain.com>
DATABASE_URL=postgresql://brewpos_user:brewpos123@localhost:5432/brewpos
