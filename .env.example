# BrewPOS - Environment Configuration (PostgreSQL)
# Copy this file to .env and fill in your values.

# --- Flask / Session ---
BREWPOS_SECRET_KEY=change_this_to_a_random_secret

# --- PostgreSQL Connection ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brewpos
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# --- Application Constants ---
LOW_STOCK_THRESHOLD=10
EXPIRING_DAYS=7

# --- SMTP / OTP Email (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_NAME=BrewPOS
OTP_EXPIRY_MINUTES=10

# --- Resend API (OTP email delivery) ---
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=BrewPOS <noreply@yourdomain.com>
DATABASE_URL=postgresql://brewpos_user:brewpos123@localhost:5432/brewpos

# --- Firebase / Google Sign-In ---
# Set these after registering a web app in the Firebase console.
FIREBASE_CREDENTIALS_JSON=your_firebase_service_account_json
BREWPOS_FIREBASE_API_KEY=your_firebase_api_key
BREWPOS_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
BREWPOS_FIREBASE_PROJECT_ID=your-project-id
BREWPOS_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
BREWPOS_FIREBASE_SENDER_ID=your_sender_id
BREWPOS_FIREBASE_APP_ID=your_app_id
